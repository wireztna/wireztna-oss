# =============================================================================
# WireZTNA Community Edition — example environment
# =============================================================================
# Copy to .env and adjust. CE defaults target a single Linux host with a PUBLIC
# IP and NO domain, served over plain HTTP. TLS is optional and external.
#
# The installer (deploy/install.sh) generates secrets and fills most of this
# for you. This file documents every setting and its CE-friendly default.
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
# JWT signing key. MUST be overridden with a strong random value.
# Generate: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# SQLite database path (single-writer; do not run multi-worker uvicorn).
DATABASE_URL=sqlite+aiosqlite:///data/wireztna.db

# JWT lifetime (hours).
JWT_EXPIRY_HOURS=24

# -----------------------------------------------------------------------------
# Public endpoint / scheme  (bare-IP, HTTP by default)
# -----------------------------------------------------------------------------
# The host's PUBLIC IP (or domain, if you have one). Used for the WireGuard
# Endpoint and for all server-generated URLs (enroll, install, portal).
# Example: 203.0.113.10
BROKER_PUBLIC_ENDPOINT=

# External scheme for generated HTTP/WS URLs. CE default is http (no TLS).
# Set to https only if you terminate TLS in front of the broker.
#   http  -> links use http://  and ws://
#   https -> links use https:// and wss://
BROKER_PUBLIC_SCHEME=http

# Public base URL override (optional). If set, takes precedence over
# BROKER_PUBLIC_SCHEME + BROKER_PUBLIC_ENDPOINT for building links.
# Example: http://203.0.113.10
PUBLIC_BASE_URL=

# Admin UI public host (optional). Leave empty to use the public IP.
UI_PUBLIC_DOMAIN=

# Extra CORS origins (comma-separated), if you front the UI from another host.
# CE adds http://<BROKER_PUBLIC_ENDPOINT> automatically; localhost is allowed in dev.
CORS_EXTRA_ORIGINS=

# -----------------------------------------------------------------------------
# Broker / overlay  (safe defaults; change only if they collide with your LAN)
# -----------------------------------------------------------------------------
BROKER_ID=broker-01
BROKER_API_KEY=                      # generated by installer (openssl rand)
BROKER_PUBLIC_KEY=                   # filled from the generated WG keypair
BROKER_WG_PORT=51820
BROKER_OVERLAY_IP=10.200.0.1
BROKER_OVERLAY_NETWORK=10.200.0.0/16
BROKER_TUNNEL_NETWORK=10.100.0.0/16

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# CE default login is USERNAME + PASSWORD. Email OTP activates ONLY when SMTP
# below is configured. Leave SMTP empty for a no-email deployment.
#
# auth_provider: local | both | oidc   (CE default: local)
AUTH_PROVIDER=local

# -----------------------------------------------------------------------------
# Email / SMTP  (OPTIONAL — leave empty to disable OTP email entirely)
# -----------------------------------------------------------------------------
# When SMTP_HOST is empty, email OTP is disabled and password login is the
# default. Onboarding emails are also skipped (set user passwords from the UI).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=WireZTNA

# -----------------------------------------------------------------------------
# OTP (used only when SMTP is configured)
# -----------------------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3

# -----------------------------------------------------------------------------
# SSO / OIDC  (OPTIONAL — disabled by default)
# -----------------------------------------------------------------------------
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# -----------------------------------------------------------------------------
# Sessions
# -----------------------------------------------------------------------------
SESSION_TTL_HOURS=8
MAX_ACTIVE_SESSIONS=1

# -----------------------------------------------------------------------------
# Access-pass limits  (CE default: UNLIMITED on self-host)
# -----------------------------------------------------------------------------
# Volume limits only make sense on a public, multi-user service you operate.
# For a self-hosted broker they default to unlimited. Set a plan to opt in.
PLAN_LIMITS_ENABLED=false
