<?xml version="1.0" encoding="utf-8"?>
<!--
  Canonical WireZTNA MSI contract — WiX 3 format for wixl.

  ProductVersion and BinDir are mandatory build-time variables. This is the only
  manifest allowed to define a WireZTNA MSI product. The installed payload is
  exactly wireztna.exe, wireztna-desktop.exe, wireztna-auth.exe, wireztna.ico,
  and wireguard.dll; wintun.dll is deliberately not part of this product.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product Id="*"
           Name="WireZTNA"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="WireZTNA"
           UpgradeCode="D8E9F0A1-B2C3-4D5E-6F7A-8B9C0D1E2F3A">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="WireZTNA — Zero Trust Network Access Client"
             Comments="Includes the WireGuard NT kernel dataplane and native WPF authentication helper" />

    <!-- Remove only strictly older products from the canonical family. -->
    <Upgrade Id="D8E9F0A1-B2C3-4D5E-6F7A-8B9C0D1E2F3A">
      <UpgradeVersion Minimum="0.0.0" IncludeMinimum="yes"
                      Maximum="$(var.ProductVersion)" IncludeMaximum="no"
                      Property="PREVIOUSFOUND" />
      <UpgradeVersion Minimum="$(var.ProductVersion)" IncludeMinimum="yes"
                      OnlyDetect="yes"
                      Property="SAMEORNEWERFOUND" />
    </Upgrade>
    <Condition Message="A same or newer version of WireZTNA is already installed.">
      Installed OR NOT SAMEORNEWERFOUND
    </Condition>
    <InstallExecuteSequence>
      <RemoveExistingProducts After="InstallInitialize">PREVIOUSFOUND</RemoveExistingProducts>
    </InstallExecuteSequence>

    <Media Id="1" Cabinet="wireztna.cab" EmbedCab="yes" />
    <Icon Id="WireZTNAIcon" SourceFile="$(var.BinDir)/wireztna.ico" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="WireZTNA" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="WireZTNA" />
      </Directory>
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="WireZTNACLI" Guid="B1C2D3E4-F5A6-4B7C-8D9E-0F1A2B3C4D5E" Win64="yes">
        <File Id="WireZTNAExe" Source="$(var.BinDir)/wireztna.exe" KeyPath="yes" />
        <ServiceInstall Id="WireZTNAService"
                        Type="ownProcess"
                        Name="WireZTNA"
                        DisplayName="WireZTNA Network Access Service"
                        Description="Manages WireGuard tunnel for Zero Trust Network Access. The desktop tray app communicates with this service via named pipe."
                        Start="auto"
                        Account="LocalSystem"
                        ErrorControl="normal"
                        Arguments="service" />
        <ServiceControl Id="WireZTNAServiceControl"
                        Name="WireZTNA"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>
      <Component Id="WireZTNADesktop" Guid="C2D3E4F5-A6B7-4C8D-9E0F-1A2B3C4D5E6F" Win64="yes">
        <File Id="WireZTNADesktopExe" Source="$(var.BinDir)/wireztna-desktop.exe" KeyPath="yes" />
      </Component>
      <Component Id="WireZTNAAuth" Guid="6A1D9E1F-1A3F-4B57-A242-8EE6AB89D102" Win64="yes">
        <File Id="WireZTNAAuthExe" Source="$(var.BinDir)/wireztna-auth.exe" KeyPath="yes" />
      </Component>
      <Component Id="AppIcon" Guid="2B3C4D5E-6F7A-4B8C-9D0E-1F2A3B4C5D6E" Win64="yes">
        <File Id="AppIconFile" Source="$(var.BinDir)/wireztna.ico" KeyPath="yes" />
      </Component>
      <Component Id="WireGuardNTDLL" Guid="7B018908-1D33-4462-9997-80493166A27A" Win64="yes">
        <File Id="WireGuardNTDll" Source="$(var.BinDir)/wireguard.dll" KeyPath="yes" />
      </Component>
      <Component Id="PathEntry" Guid="F5A6B7C8-D9E0-4F1A-2B3C-4D5E6F7A8B9C" Win64="yes">
        <Environment Id="PATH" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="yes" />
        <RegistryValue Id="WireZTNAInstallDirRegistry" Root="HKLM" Key="Software\WireZTNA" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="A1B2C3D4-E5F6-4A7B-8C9D-0E1F2A3B4C5D" Win64="yes">
        <Shortcut Id="WireZTNAShortcut"
                  Name="WireZTNA"
                  Description="WireZTNA — Zero Trust Network Access"
                  Target="[INSTALLFOLDER]wireztna-desktop.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="WireZTNAIcon"
                  IconIndex="0" />
        <RemoveFolder Id="CleanupStartMenu" On="uninstall" />
        <RegistryValue Id="StartMenuShortcutRegistry" Root="HKLM" Key="Software\WireZTNA" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="TrayAutostart" Guid="E4F5A6B7-C8D9-4E0F-1A2B-3C4D5E6F7A8B" Win64="yes">
        <RegistryValue Id="WireZTNATrayAutostartRegistry"
                       Root="HKLM"
                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="WireZTNA"
                       Type="string"
                       Value="&quot;[INSTALLFOLDER]wireztna-desktop.exe&quot;"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
    <Property Id="MSIRMSHUTDOWN" Value="2" />

    <Feature Id="MainFeature" Title="WireZTNA Client" Level="1">
      <ComponentRef Id="WireZTNACLI" />
      <ComponentRef Id="WireZTNADesktop" />
      <ComponentRef Id="WireZTNAAuth" />
      <ComponentRef Id="AppIcon" />
      <ComponentRef Id="WireGuardNTDLL" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="TrayAutostart" />
      <ComponentRef Id="PathEntry" />
    </Feature>

  </Product>
</Wix>
