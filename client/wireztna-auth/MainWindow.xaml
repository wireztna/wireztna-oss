<Window x:Class="WireZTNA.Auth.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="WireZTNA"
        Width="440" Height="580" MinWidth="400" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        KeyboardNavigation.TabNavigation="Cycle"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Window.Background>
        <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.9" RadiusY="0.72">
            <GradientStop Color="#211D3F" Offset="0" />
            <GradientStop Color="#0D0F1A" Offset="0.72" />
        </RadialGradientBrush>
    </Window.Background>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid Margin="34,26,34,18" MinHeight="430">
                <!-- Enrollment -->
                <StackPanel x:Name="EnrollView" VerticalAlignment="Center" Visibility="Collapsed" automation:AutomationProperties.Name="Device enrollment">
                    <Border Width="58" Height="58" CornerRadius="15" Background="#251F4A" BorderBrush="#443A86" BorderThickness="1" HorizontalAlignment="Center">
                        <Path Data="M12,2 L21,7 L21,13 C21,18.5 17.2,23.7 12,25 C6.8,23.7 3,18.5 3,13 L3,7 Z M8.5,13 L11,15.5 L16,10.5"
                              Stroke="{StaticResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="27" Height="29" Stretch="Uniform" />
                    </Border>
                    <TextBlock Style="{StaticResource TitleTextStyle}" Text="Welcome to WireZTNA" />
                    <TextBlock Style="{StaticResource BodyTextStyle}" Text="Paste your enrollment URL to register this device securely." Margin="0,0,0,26" />
                    <Label Target="{Binding ElementName=EnrollmentUrlBox}" Content="ENROLLMENT URL" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" Padding="0" Margin="0,0,0,7" />
                    <TextBox x:Name="EnrollmentUrlBox" automation:AutomationProperties.Name="Enrollment URL" automation:AutomationProperties.HelpText="Paste the enrollment URL supplied by your administrator" ToolTip="Enrollment URL supplied by your administrator" />
                    <Border x:Name="EnrollErrorBorder" Background="#24171F" BorderBrush="#5B2938" BorderThickness="1" CornerRadius="9" Margin="0,12,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="EnrollErrorText" Style="{StaticResource ErrorTextStyle}" Background="Transparent" automation:AutomationProperties.LiveSetting="Assertive" />
                    </Border>
                    <Button x:Name="EnrollButton" Style="{StaticResource PrimaryButtonStyle}" Content="Enroll this device" Margin="0,16,0,0" IsDefault="True" Click="EnrollButton_Click" automation:AutomationProperties.Name="Enroll this device" />
                </StackPanel>

                <!-- Sign in -->
                <StackPanel x:Name="LoginView" VerticalAlignment="Center" Visibility="Collapsed" automation:AutomationProperties.Name="Sign in">
                    <Border Width="58" Height="58" CornerRadius="15" Background="#251F4A" BorderBrush="#443A86" BorderThickness="1" HorizontalAlignment="Center">
                        <Path Data="M3,6 L21,6 C22,6 23,7 23,8 L23,19 C23,20 22,21 21,21 L3,21 C2,21 1,20 1,19 L1,8 C1,7 2,6 3,6 Z M2,8 L12,14 L22,8"
                              Stroke="{StaticResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="28" Height="24" Stretch="Uniform" />
                    </Border>
                    <TextBlock Style="{StaticResource TitleTextStyle}" Text="Sign In" />
                    <TextBlock x:Name="LoginDescriptionText" Style="{StaticResource BodyTextStyle}" Text="A 6-digit access code will be sent to your registered email." Margin="0,0,0,24" />
                    <Border x:Name="LoginErrorBorder" Background="#24171F" BorderBrush="#5B2938" BorderThickness="1" CornerRadius="9" Margin="0,0,0,14" Visibility="Collapsed">
                        <TextBlock x:Name="LoginErrorText" Style="{StaticResource ErrorTextStyle}" Background="Transparent" automation:AutomationProperties.LiveSetting="Assertive" />
                    </Border>
                    <Button x:Name="LoginButton" Style="{StaticResource PrimaryButtonStyle}" Content="Send access code" IsDefault="True" Click="LoginButton_Click" automation:AutomationProperties.Name="Send access code" />
                </StackPanel>

                <!-- OTP -->
                <StackPanel x:Name="OtpView" VerticalAlignment="Center" Visibility="Collapsed" automation:AutomationProperties.Name="Enter access code">
                    <Border Width="58" Height="58" CornerRadius="15" Background="#251F4A" BorderBrush="#443A86" BorderThickness="1" HorizontalAlignment="Center">
                        <Path Data="M5,11 L19,11 C20.1,11 21,11.9 21,13 L21,22 C21,23.1 20.1,24 19,24 L5,24 C3.9,24 3,23.1 3,22 L3,13 C3,11.9 3.9,11 5,11 Z M7,11 L7,7 C7,4.2 9.2,2 12,2 C14.8,2 17,4.2 17,7 L17,11"
                              Stroke="{StaticResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="26" Height="29" Stretch="Uniform" />
                    </Border>
                    <TextBlock Style="{StaticResource TitleTextStyle}" Text="Enter Code" />
                    <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,0,0,18">
                        <Run Text="Sent to " /><Run x:Name="OtpEmailRun" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                    </TextBlock>
                    <UniformGrid x:Name="OtpInputGrid" Rows="1" Columns="6" Margin="0,0,0,15">
                        <TextBox x:Name="OtpDigit1" MaxLength="1" TextAlignment="Center" FontSize="22" FontWeight="Bold" Padding="0" Height="54" Margin="3" automation:AutomationProperties.Name="Digit 1 of 6" />
                        <TextBox x:Name="OtpDigit2" MaxLength="1" TextAlignment="Center" FontSize="22" FontWeight="Bold" Padding="0" Height="54" Margin="3" automation:AutomationProperties.Name="Digit 2 of 6" />
                        <TextBox x:Name="OtpDigit3" MaxLength="1" TextAlignment="Center" FontSize="22" FontWeight="Bold" Padding="0" Height="54" Margin="3" automation:AutomationProperties.Name="Digit 3 of 6" />
                        <TextBox x:Name="OtpDigit4" MaxLength="1" TextAlignment="Center" FontSize="22" FontWeight="Bold" Padding="0" Height="54" Margin="3" automation:AutomationProperties.Name="Digit 4 of 6" />
                        <TextBox x:Name="OtpDigit5" MaxLength="1" TextAlignment="Center" FontSize="22" FontWeight="Bold" Padding="0" Height="54" Margin="3" automation:AutomationProperties.Name="Digit 5 of 6" />
                        <TextBox x:Name="OtpDigit6" MaxLength="1" TextAlignment="Center" FontSize="22" FontWeight="Bold" Padding="0" Height="54" Margin="3" automation:AutomationProperties.Name="Digit 6 of 6" />
                    </UniformGrid>
                    <Border x:Name="OtpErrorBorder" Background="#24171F" BorderBrush="#5B2938" BorderThickness="1" CornerRadius="9" Margin="0,0,0,14" Visibility="Collapsed">
                        <TextBlock x:Name="OtpErrorText" Style="{StaticResource ErrorTextStyle}" Background="Transparent" automation:AutomationProperties.LiveSetting="Assertive" />
                    </Border>
                    <Button x:Name="VerifyButton" Style="{StaticResource PrimaryButtonStyle}" Content="Verify code" IsEnabled="False" IsDefault="True" Click="VerifyButton_Click" automation:AutomationProperties.Name="Verify access code" />
                    <Button x:Name="ResendButton" Style="{StaticResource SecondaryButtonStyle}" Content="Resend code" Margin="0,10,0,0" Click="ResendButton_Click" automation:AutomationProperties.Name="Resend access code" />
                </StackPanel>

                <!-- Connecting -->
                <StackPanel x:Name="ConnectingView" VerticalAlignment="Center" Visibility="Collapsed" automation:AutomationProperties.Name="Connecting to WireZTNA">
                    <Border Width="66" Height="66" CornerRadius="33" Background="#251F4A" BorderBrush="#443A86" BorderThickness="1" HorizontalAlignment="Center">
                        <Grid>
                            <Ellipse Width="32" Height="32" Stroke="#3B3D5B" StrokeThickness="4" />
                            <Path Data="M16,0 A16,16 0 0 1 32,16" Stroke="{StaticResource AccentBrush}" StrokeThickness="4" StrokeStartLineCap="Round" Width="32" Height="32" Stretch="Fill" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform><RotateTransform x:Name="SpinnerRotation" /></Path.RenderTransform>
                                <Path.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="SpinnerRotation" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.8" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Path.Triggers>
                            </Path>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="ConnectingTitleText" Style="{StaticResource TitleTextStyle}" Text="Connecting…" Focusable="True" automation:AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="ConnectingDescriptionText" Style="{StaticResource BodyTextStyle}" Text="Creating a secure WireZTNA session." />
                </StackPanel>

                <!-- Disconnected / ready -->
                <StackPanel x:Name="DisconnectedView" VerticalAlignment="Center" Visibility="Collapsed" automation:AutomationProperties.Name="WireZTNA ready">
                    <Border Width="66" Height="66" CornerRadius="33" Background="#251F4A" BorderBrush="#443A86" BorderThickness="1" HorizontalAlignment="Center">
                        <Path Data="M5,11 L19,11 C20.1,11 21,11.9 21,13 L21,22 C21,23.1 20.1,24 19,24 L5,24 C3.9,24 3,23.1 3,22 L3,13 C3,11.9 3.9,11 5,11 Z M7,11 L7,7 C7,4.2 9.2,2 12,2 C14.8,2 17,4.2 17,7 L17,11"
                              Stroke="{StaticResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="28" Height="31" Stretch="Uniform" />
                    </Border>
                    <TextBlock x:Name="DisconnectedTitleText" Style="{StaticResource TitleTextStyle}" Text="Ready to connect" automation:AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="DisconnectedDescriptionText" Style="{StaticResource BodyTextStyle}" Text="Use the tray or TUI to connect and choose your network mode." Margin="0,0,0,24" TextWrapping="Wrap" />
                    <Button x:Name="DisconnectedCloseButton" Style="{StaticResource SecondaryButtonStyle}" Content="Close" Click="CloseButton_Click" automation:AutomationProperties.Name="Close WireZTNA authentication" />
                </StackPanel>

                <!-- Success -->
                <StackPanel x:Name="SuccessView" VerticalAlignment="Center" Visibility="Collapsed" automation:AutomationProperties.Name="Connected successfully">
                    <Border Width="70" Height="70" CornerRadius="35" Background="#162C29" BorderBrush="#296550" BorderThickness="1" HorizontalAlignment="Center">
                        <Path Data="M4,12 L10,18 L22,5" Stroke="{StaticResource SuccessBrush}" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="30" Height="25" Stretch="Uniform" />
                    </Border>
                    <TextBlock x:Name="SuccessTitleText" Style="{StaticResource TitleTextStyle}" Text="You're connected" Foreground="{StaticResource SuccessBrush}" automation:AutomationProperties.LiveSetting="Assertive" />
                    <TextBlock Style="{StaticResource BodyTextStyle}" Text="WireZTNA is active and securing your traffic." Margin="0,0,0,24" />
                    <Button x:Name="SuccessCloseButton" Style="{StaticResource SecondaryButtonStyle}" Content="Close" Click="CloseButton_Click" automation:AutomationProperties.Name="Close WireZTNA authentication" />
                </StackPanel>

                <!-- Error -->
                <StackPanel x:Name="ErrorView" VerticalAlignment="Center" Visibility="Collapsed" automation:AutomationProperties.Name="WireZTNA error">
                    <Border Width="66" Height="66" CornerRadius="33" Background="#321A25" BorderBrush="#713344" BorderThickness="1" HorizontalAlignment="Center">
                        <TextBlock Text="!" Foreground="{StaticResource DangerBrush}" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Style="{StaticResource TitleTextStyle}" Text="Something went wrong" />
                    <TextBlock x:Name="FatalErrorText" Style="{StaticResource BodyTextStyle}" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,22" automation:AutomationProperties.LiveSetting="Assertive" />
                    <Button x:Name="RetryButton" Style="{StaticResource PrimaryButtonStyle}" Content="Try again" Click="RetryButton_Click" automation:AutomationProperties.Name="Try again" />
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Close" Margin="0,10,0,0" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <TextBlock Grid.Row="1" x:Name="VersionText" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextAlignment="Center" Margin="8,0,8,12" automation:AutomationProperties.Name="WireZTNA version" />
    </Grid>
</Window>
