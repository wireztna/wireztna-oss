<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WireZTNA.Auth</RootNamespace>
    <AssemblyName>wireztna-auth</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Version>0.9.30</Version>
    <AssemblyVersion>0.9.30.0</AssemblyVersion>
    <FileVersion>0.9.30.0</FileVersion>
    <InformationalVersion>0.9.30</InformationalVersion>
    <Product>WireZTNA Auth</Product>
    <Company>WireZTNA</Company>
    <Description>WireZTNA enrollment and authentication wizard</Description>
    <Copyright>Copyright 2024-2026 WireZTNA</Copyright>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>../wireztna-go/packaging/windows/wireztna.ico</ApplicationIcon>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
